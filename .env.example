# Copy to .env and fill in
SECRET_KEY=replace-with-a-long-random-string
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/campushire

# Optional: without a key, applications are scored from GPA/credits/level/school only
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

FLASK_DEBUG=1
